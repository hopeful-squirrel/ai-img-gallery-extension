{
  "manifest_version": 3,
  "name": "갤러리 프롬프트 패널",
  "description": "gallery.ai-thanks.com의 프롬프트를 NovelAI에 바로 넣고, 새 프롬프트를 이미지와 함께 갤러리에 저장합니다.",
  "version": "0.1.0",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "host_permissions": [
    "https://gallery.ai-thanks.com/*",
    "https://novelai.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "갤러리 프롬프트 패널 열기"
  },
  "content_scripts": [
    {
      "matches": ["https://novelai.net/*"],
      "js": ["content/nai.js"],
      "css": ["content/nai.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
